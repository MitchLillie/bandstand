        "    if(parsedToken.length != 3){",
        "      return null;",
        "    }",
        "    parsedToken = {",
        "      header: JSON.parse(atob(parsedToken[0])), payload: JSON.parse(atob(parsedToken[1])), signature: parsedToken[2]",
        "    }",
        "    return parsedToken",
        "  }",
        "  catch(error){",
        "    if(errorHandler != undefined){",
        "      errorHandler(error);",
        "    }",
        "    return null;",
        "  }",
        "}"
